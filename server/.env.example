# ══════════════════════════════════════════════════════
# AIS Backend — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════

# Server Environment
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────
# PostgreSQL / Neon (use pooled connection string in production)
# Production format: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:root@localhost:5432/ais_db?schema=public"

# ── JWT Authentication ────────────────────────────────
# Generate with: npm run generate:secrets  (or node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
# MUST be 64-char random hex strings in production. Never reuse dev secrets in prod.
JWT_ACCESS_SECRET="generate_with_npm_run_generate_secrets_64_char_hex"
JWT_REFRESH_SECRET="generate_with_npm_run_generate_secrets_64_char_hex"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ── CORS ──────────────────────────────────────────────
# Comma-separated list of allowed origins. No trailing slashes.
# Development:  http://localhost:5173
# Production:   https://your-site.vercel.app,https://yourdomain.com
CORS_ORIGIN="http://localhost:5173"

# ── Application URLs ──────────────────────────────────
# Used for OAuth callback redirects.
# Development:
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:5000"
# Production example:
# FRONTEND_URL="https://your-site.vercel.app"
# BACKEND_URL="https://ais-backend.onrender.com"

# ── Google OAuth 2.0 ──────────────────────────────────
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {BACKEND_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── GitHub OAuth 2.0 ──────────────────────────────────
# https://github.com/settings/developers → OAuth Apps
# Authorization callback URL: {BACKEND_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── Dev Mock OAuth ────────────────────────────────────
# When set to "true" and OAuth client IDs are missing, enables 1-click
# simulated Google/GitHub login for local development.
# MUST be "false" in production.
ALLOW_DEV_OAUTH="true"

# ── Admin Seed Credentials ────────────────────────────
# Used ONLY when running: npm run db:seed
# Set a strong password — this creates the initial SUPER_ADMIN account.
SEED_ADMIN_EMAIL="admin@abhimanyuinfosec.com"
SEED_ADMIN_PASSWORD="ChangeThisToAStrongPassword2026!"
SEED_ADMIN_NAME="System Administrator"
