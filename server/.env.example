# Server Environment
PORT=5000
NODE_ENV=development

# Database (PostgreSQL / Neon pooled connection)
DATABASE_URL="postgresql://user:password@ep-sample-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication Secrets (Must be 64-byte random hex string: run `npm run generate:secrets`)
JWT_ACCESS_SECRET="generate_with_npm_run_generate_secrets_64_char_hex"
JWT_REFRESH_SECRET="generate_with_npm_run_generate_secrets_64_char_hex"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# CORS Allowed Origins (comma-separated for multiple origins e.g. local + Vercel)
CORS_ORIGIN="http://localhost:5173,https://your-frontend-app.vercel.app"

# Application URLs (for OAuth callbacks & redirects)
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:5000"

# Google OAuth 2.0 Credentials (https://console.cloud.google.com/apis/credentials)
# Callback URL: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth 2.0 Credentials (https://github.com/settings/developers)
# Callback URL: http://localhost:5000/api/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Dev Mock OAuth simulation: when client IDs are not configured, enables simulated 1-click test login in development
ALLOW_DEV_OAUTH="true"
