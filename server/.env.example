# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ais_db?schema=public"

# Security & JWT Tokens
JWT_ACCESS_SECRET="ais_access_secret_super_secure_key_change_in_production_2026"
JWT_REFRESH_SECRET="ais_refresh_secret_super_secure_key_change_in_production_2026"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# CORS Allowed Origins
CORS_ORIGIN="http://localhost:5173"

# Uploads Configuration
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# Super Admin Initial Credentials (for database seed)
SEED_ADMIN_EMAIL="admin@abhimanyuinfosec.com"
SEED_ADMIN_PASSWORD="AdminSecurePassword2026!"
SEED_ADMIN_NAME="System Administrator"
