# Server Environment
PORT=5000
NODE_ENV=development

# Database (PostgreSQL / Neon pooled connection)
DATABASE_URL="postgresql://user:password@ep-sample-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="your_production_jwt_access_secret_here"
JWT_REFRESH_SECRET="your_production_jwt_refresh_secret_here"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# CORS Allowed Origins (comma-separated for multiple origins e.g. local + Vercel)
CORS_ORIGIN="http://localhost:5173,https://your-frontend-app.vercel.app"

# Application URLs (for OAuth callbacks & redirects)
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:5000"

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth 2.0 Credentials
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
